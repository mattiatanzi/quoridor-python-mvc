Screen {
    align: center middle;
    background: $surface;
}

#menu-container {
    width: 50;
    height: auto;
    border: double $accent;
    padding: 1 2;
    background: $panel;
    align: center middle;
}

#menu-titolo {
    text-align: center;
    text-style: bold;
    color: $text;
    width: 100%;
    margin-bottom: 2;
}

Button {
    width: 100%;
    margin-bottom: 1;
}

/* Il bottone 'Esci' lo facciamo diventare rosso al passaggio del mouse */
#btn_Esci:hover {
    background: $error;
}

/*---------------------------------*/
/* CSS per griglia del tavoliere*/

/* Stile base delle caselle del tabellone */
.casella {
    width: 100%;
    height: 100%;
    background: $surface-lighten-3; /* Colore di sfondo della casella vuota */
    border: none;               /* Di base, nessun muro! */
}

/* Effetto quando passi il mouse sopra una casella vuota */
.casella:hover {
    background: $accent-muted;
}

/* =========================================
   LA MAGIA DEI MURI: Il Trucco dei Bordi
========================================= */

/* Se il nodo non ha l'arco SOTTO, accendiamo il bordo inferiore */
.casella.muro-sotto {
    border-bottom: heavy $warning; /* Bordo spesso e giallo/arancione */
}

/* Se il nodo non ha l'arco DESTRA, accendiamo il bordo destro */
.casella.muro-destra {
    border-right: heavy $warning; 
}

/* Nel caso raro (ma possibile in Quoridor) di un incrocio con due muri */
.casella.muro-sotto.muro-destra {
    border-bottom: heavy $warning;
    border-right: heavy $warning;
}

/* Colori delle pedine dei giocatori */
.casella.giocatore-1 { 
    background: #FF5555; /* Rosso per il Player 1 */
    color: white; 
    text-style: bold; 
}

.casella.giocatore-2 { 
    background: #5555FF; /* Blu per il Player 2 */
    color: white; 
    text-style: bold; 
}


.casella.giocatore-3 { 
    background: #55ff82; /* Verde per il Player 3 */
    color: white; 
    text-style: bold; 
}

.casella.giocatore-4 { 
    background: #ddff55; /* Giallo per il Player 4 */
    color: white; 
    text-style: bold; 
}
/* -------------------------------- */
/* Widget Tavoliere                 */
/* -------------------------------- */

TavoliereViewWidget {
    width: 1fr;         /* Occupa tutto lo spazio orizzontale rimanente */
    height: 100%;
    align: center middle;
    padding: 1 2;
}

#griglia-tavoliere {
    /* Definisce una griglia esatta di 10x10 */
    grid-size: 10 10;
    
    /* Definisce le larghezze: la colonna dei numeri fissa a 4 char, le altre si espandono ugualmente (1fr) */
    grid-columns: 4 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
    
    /* Definisce le altezze: la riga delle lettere fissa a 2 char, le altre si espandono ugualmente (1fr) */
    grid-rows: 2 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
    
    width: 100%;
    height: 100%;
    
    /* Rimuove lo spazio vuoto tra le caselle, fondamentale per far "toccare" i bordi dei muri */
    grid-gutter: 0 0; 
}

/* Stile per centrare perfettamente i numeri e le lettere a lato della griglia */
#griglia-tavoliere > Label {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-style: bold;
    color: $text-muted;
}
/* Fine CSS tavoliere*/
/*--------------------------*/

/*--------------------------*/


/* -------------------------------- */
/* Layout principale della partita  */
/* -------------------------------- */

#partita-container {
    width: 100%;
    height: 100%;
}

/* Pannello laterale sinistro */
#pannello-laterale {
    width: 28;
    height: 100%;
    border-right: solid $accent;
    padding: 1 1;
    background: $panel;
}

#label-titolo-giocatori {
    text-style: bold;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
    color: $accent;
}

#label-input-hint {
    margin-top: 1;
    color: $text-muted;
}

#input-mossa {
    width: 100%;
    margin-top: 0;
}

.label-errore {
    color: $error;
    width: 100%;
    height: auto;
    margin-top: 1;
}

/* -------------------------------- */
/* Widget singolo giocatore         */
/* -------------------------------- */

.giocatore-box {
    width: 100%;
    padding: 0 1;
    border: solid $surface-lighten-2;
    margin-bottom: 1;
    height: auto;
}

.giocatore-attivo > .giocatore-box {
    border: solid $accent;
    background: $surface-lighten-1;
}

.giocatore-eliminato > .giocatore-box {
    color: $text-muted;
    background: $surface-darken-1;
}
/*-----------------*/