/* ======================================================== */
/* STILE GENERALE APP QUORIDOR TUI                          */
/* ======================================================== */

Screen {
    background: $surface;
}

/* -------------------------------------------------------- */
/* LAYOUT MENU PRINCIPALI E PANNELLO AIUTO                  */
/* -------------------------------------------------------- */

.layout-menu-aiuto {
    layout: horizontal;
    width: 100%;
    height: 100%;
}

/* Contenitori centrali dei bottoni */
/* Contenitori centrali dei bottoni */
#menu-container, #menu-modalita-container, #menu-timer-container, #menu-giocatori-container,#menu-vittoria-container {
    width: 1fr;
    height: 100%;
    align: center middle;
    padding: 2 4;
}

#menu-titolo, #titolo-modalita, #titolo-timer, #titolo-giocatori {
    text-style: bold;
    color: $text;
    content-align: center middle;
    margin-bottom: 2;
    width: 100%;
}

/* Tutti i bottoni dei menu */
Button {
    width: 100%;
    margin-bottom: 1;
}

/* Il pannello laterale a scomparsa per l'aiuto */
#pannello-aiuto {
    width: 0;
    height: 100%;
    background: $panel;
    border-left: blank;
    padding: 0;
    content-align: left top;
    transition: width 0.3s in_out_cubic; /* Effetto slide morbido */
}

/* Quando il controller aggiunge la classe 'visibile' il pannello si apre */
#pannello-aiuto.visibile {
    width: 40;
    border-left: heavy $primary;
    padding: 2;
}


/* -------------------------------------------------------- */
/* LAYOUT SCHERMATA PARTITA                                 */
/* -------------------------------------------------------- */

#partita-container {
    layout: horizontal;
    width: 100%;
    height: 100%;
}

/* Colonna sinistra per l'elenco giocatori */
/* Colonna SINISTRA per l'elenco giocatori */
#pannello-giocatori {
    width: 35;
    height: 100%;
    border-right: heavy $primary; 
    padding: 1 2;
    background: $panel;
    
    /* AGGIUNGI QUESTE DUE RIGHE */
    overflow-y: auto;      /* Attiva la scrollbar se necessario */
    scrollbar-gutter: stable; /* Mantiene lo spazio per la scrollbar */
}

#label-titolo-giocatori {
    text-style: bold;
    width: 100%;
    text-align: center;
    margin-bottom: 2;
}

/* ========================================= */
/* STILE DEI RIQUADRI GIOCATORI E TURNO      */
/* ========================================= */

GiocatoreViewWidget {
    height: auto;
    margin-bottom: 1;
}

/* Riquadro standard per tutti i giocatori in attesa */
.giocatore-box {
    width: 100%;
    height: auto;
    padding: 1;
    border: round ;
    background: $surface;
}

/* IL SEGNO DEL TURNO: Quando tocca a lui si illumina! */
GiocatoreViewWidget.giocatore-attivo > .giocatore-box {
    border: double $warning; /* Bordo doppio e dorato */
    background: $surface-lighten-2; /* Sfondo che risalta */
}

/* Colora di dorato la scritta "► P1 - TURNO" */
GiocatoreViewWidget.giocatore-attivo .giocatore-label-stato {
    color: $warning;
    text-style: bold italic;
}

/* Oscura e tratteggia i giocatori eliminati o arresi */
GiocatoreViewWidget.giocatore-eliminato > .giocatore-box {
    border: dashed $error;
    opacity: 0.5;
}

/* Spazio centrale dove si posiziona il tavoliere */
#area-gioco {
    width: 1fr;
    height: 100%;
    align: center middle;
    layout: vertical;
    overflow: auto; /* IMPORTANTE: Se il terminale è piccolo, appare la scrollbar! */
}

/* La fascia in basso a destra per Resa e Uscita */
#azioni-partita {
    height: auto;
    width: 100%;
    align: right middle;
    padding: 1 2;
    layout: horizontal;
}

#azioni-partita > Button {
    width: 25;
    margin-left: 2;
}


/* -------------------------------------------------------- */
/* TAVOLIERE CON COORDINATE ESTERNE                         */
/* -------------------------------------------------------- */

#contenitore-tavoliere-completo {
    width: auto;
    height: auto;
    align: center middle;
}

#fascia-centrale {
    width: auto;
    height: auto;
    layout: horizontal;
}

/* Colonna dei Numeri (Sinistra) */
#colonna-numeri {
    width: 2;
    height: 37; 
    margin-top: 1; 
    margin-right: 1;
}

.label-numero {
    height: 3; /* Esattamente l'altezza della riga della casella */
    width: 100%;
    content-align: right middle;
    margin-bottom: 1; /* Esattamente l'altezza del muro orizzontale */
    color: $text-muted;
    text-style: bold;
}

/* Riga delle Lettere (Sopra la griglia) */
#riga-lettere {
    width: 90; 
    height: 1;
    margin-left: 3; /* Salta la colonna numeri e il bordo sinistro */
    margin-bottom: 1; /* Crea lo spazio tra le lettere e il tetto del tavoliere */
    layout: horizontal;
}

.label-lettera {
    width: 8; /* Esattamente la larghezza della colonna casella */
    height: 100%;
    content-align: center top;
    margin-right: 2; /* Esattamente la larghezza del muro verticale */
    color: $text-muted;
    text-style: bold;
}

/* -------------------------------------------------------- */
/* LA GRIGLIA INTERNA 17x17 (MATEMATICAMENTE PERFETTA)      */
/* -------------------------------------------------------- */

#griglia-tavoliere {
    layout: grid;
    grid-size: 17 17;
    
    /* IL SEGRETO: Fissiamo le dimensioni di ogni singola colonna e riga! */
    /* Colonne: Casella(8) Muro(2) Casella(8) Muro(2) ... */
    grid-columns: 8 2 8 2 8 2 8 2 8 2 8 2 8 2 8 2 8;
    
    /* Righe: Casella(3) Muro(1) Casella(3) Muro(1) ... */
    grid-rows: 3 1 3 1 3 1 3 1 3 1 3 1 3 1 3 1 3;
    
    grid-gutter: 0 0;
    
    /* (9 * 8) + (8 * 2) = 88 + 2 di bordi = 90 esatti */
    width: 90; min-width: 90;
    
    /* (9 * 3) + (8 * 1) = 35 + 2 di bordi = 37 esatti */
    height: 37; min-height: 37;
    
    border: heavy $primary;
    background: $surface-darken-2;
}

/* 1. Caselle: Il quadrato perfetto (6x3) centrato nello slot da 8 */
/* 1. Caselle: Il quadrato perfetto (6x3) centrato nello slot da 8 */
/* 1. Caselle: Il quadrato perfetto (6x3) centrato nello slot da 8 */
.casella { 
    width: 6; min-width: 6; 
    height: 3; min-height: 3; 
    margin: 0 1; /* Questo annulla il margine globale in automatico */
    padding: 0 !important;
    background: $surface-lighten-2; 
    border: none; 
    color: white; 
    text-style: bold; 
}

/* 2. Muri Verticali: Blindati a 2x3 */
.muro-v { 
    width: 2; min-width: 2;
    height: 3; min-height: 3; 
    background: $surface-darken-1; 
    border: none; 
    margin: 0 !important; /* IMMUNIZZAZIONE */
    padding: 0 !important; /* Rimuove lo spessore interno del bottone Textual */
}

/* 3. Muri Orizzontali: Blindati a 8x1 (Larghi come la colonna della casella) */
.muro-h { 
    width: 8; min-width: 8;
    height: 1; min-height: 1; 
    background: $surface-darken-1; 
    border: none;
    margin: 0 !important; /* IMMUNIZZAZIONE DAL MARGINE GLOBALE */
    padding: 0 !important; /* Forza l'altezza a 1 riga esatta */
}

/* 4. Intersezione (2x1) */
.intersezione { 
    width: 2; min-width: 2;
    height: 1; min-height: 1; 
    background: $surface-darken-3; 
    margin: 0 !important;
    padding: 0 !important;
}
/* Hover e Colori (Invariati) */
.casella:hover { background: $accent; }
.muro-v:hover, .muro-h:hover { background: $success-muted; }
.muro-piazzato { background: $warning !important; }

.giocatore-1 { background: $error; color: white;}
.giocatore-2 { background: $secondary; color: white;}
.giocatore-3 { background: $success; color: white;}
.giocatore-4 { background: $primary; color: white;}

/* -------------------------------------------------------- */
/* SCHERMATA CRASH PYTHON (ModalScreen per Errori Fatali)   */
/* -------------------------------------------------------- */

ErroreFataleScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.85); /* Sfondo scuro semitrasparente */
}

#pannello-crash {
    width: 80%;
    height: auto;
    background: $error-darken-3;
    border: heavy $error;
    padding: 1 2;
}

#titolo-crash {
    text-style: bold;
    color: white;
    width: 100%;
    text-align: center;
}

#sottotitolo-crash {
    color: $warning;
    text-style: italic;
    margin-bottom: 1;
}

#testo-crash {
    color: white;
    background: $surface;
    border: solid;
    padding: 1;
    margin-bottom: 2;
    height: auto;
}

#btn-chiudi-crash {
    width: 100%;
    margin-bottom: 0;
/* Rimuove il margine solo per il pulsante d'emergenza */
}


/* -------------------------------------------------------- */
/* SCHERMATA TRASCRIZIONE E WIDGET                          */
/* -------------------------------------------------------- */

TrascrizioneScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.85); /* Oscura il gioco dietro */
}

#pannello-trascrizione {
    width: 60;
    height: 80%; /* Occupa l'80% dell'altezza dello schermo */
    background: $panel;
    border: heavy $success;
    padding: 1 2;
    align: center top;
}

#titolo-trascrizione {
    text-style: bold;
    color: $success;
    margin-bottom: 1;
    width: 100%;
    text-align: center;
}

/* Stile per il Widget Riutilizzabile */
TrascrizioneWidget {
    width: 100%;
    height: 1fr; /* Prende tutto lo spazio in altezza lasciato libero */
    border: solid;
    background: $surface;
    margin-bottom: 1;
}

#trascrizione-scroll {
    width: 100%;
    height: 100%;
}

#trascrizione-testo {
    width: 100%;
    height: auto;
    padding: 1;
}

/* -------------------------------------------------------- */
/* SCHERMATA VITTORIA (Overlay e Nascondi Menu)             */
/* -------------------------------------------------------- */

VittoriaModalScreen {
    align: center middle;
    /* Oscura leggermente il tabellone dietro, ma lo lascia ben visibile */
    background: rgba(0, 0, 0, 0.35);
}

/* Posiziona il bottoncino di ritorno in cima allo schermo */
#btn-ripristina-vittoria {
    position: absolute;
    
    
    offset: 82% 1; 
    
    width: auto;      /* Si stringe attorno al testo */
    min-width: 12;    /* Dimensione minima protetta */
    text-style: bold;
}

/* La classe magica che fa sparire i componenti */
.nascosto {
    display: none !important;
}