/* ======================================================== */
/* QUORIDOR TUI - STILE COMPLETO                            */
/* ======================================================== */

/* -------------------------------------------------------- */
/* 1. IMPOSTAZIONI GENERALI                                 */
/* -------------------------------------------------------- */
Screen {
    align: center middle;
    background: $surface;
}

/* -------------------------------------------------------- */
/* 2. MENU E PANNELLO AIUTO (Stile Unificato per i 3 Menu)  */
/* -------------------------------------------------------- */

.layout-menu-aiuto {
    width: auto;     /* FONDAMENTALE: fa restringere il container alla dimensione esatta dei suoi figli */
    height: auto;    /* FONDAMENTALE: altezza dinamica */
    layout: horizontal;
}

#menu-container, #menu-modalita-container, #menu-timer-container {
    width: 50;
    height: auto;
    border: heavy $accent;    
    padding: 1 2;
    background: $panel;       
    align: center middle;
}

#menu-titolo, #titolo-modalita, #titolo-timer {
    text-align: center;
    text-style: bold;
    color: $text;
    width: 100%;
    margin-bottom: 2;
}

Button {
    width: 100%;
    margin-bottom: 1;
}

Button:hover {
    background: $accent-darken-1;
}

#btn-Esci, #btn-indietro {
    background: $error;
    color: $text;
}

#btn-Esci:hover, #btn-indietro:hover {
    background: $error-darken-2;
}

Input {
    width: 100%;
    margin-bottom: 1;
}

#pannello-aiuto {
    width: 45;
    height: auto;
    min-height: 15;
    margin-left: 4;
    padding: 1 2;
    border: solid $success;
    background: $surface-lighten-1;
    display: none; 
}

#pannello-aiuto.visibile {
    display: block;
}

/* -------------------------------------------------------- */
/* 3. LAYOUT SCHERMATA DELLA PARTITA                        */
/* -------------------------------------------------------- */

#partita-container, #layout-partita {
    layout: horizontal;
    width: 100%;
    height: 100%;
}

/* -------------------------------------------------------- */
/* 4. TAVOLIERE E GRIGLIA CASELLE                           */
/* -------------------------------------------------------- */

TavoliereViewWidget {
    width: 1fr;           
    height: 100%;
    align: center middle;
    padding: 1 4;         
}

#griglia-tavoliere {
    layout: grid;
    grid-size: 10 10;
    
    grid-columns: 4 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
    grid-rows: 2 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr;
    
    width: 100%;
    height: 100%;
    
    /* Gutter a 0 fa toccare i bordi, essenziale per i muri! */
    grid-gutter: 0 0;
    
    border: round $primary-muted; 
    padding: 1 2;
    background: $surface-darken-1;
}

#griglia-tavoliere > Label {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-style: bold;
    color: $text-muted;
}

/* -------------------------------------------------------- */
/* 5. LE CASELLE E GLI HOVER (Illuminazione Movimento/Muro) */
/* -------------------------------------------------------- */

.casella {
    width: 100%;
    height: 100%;
    background: $surface-lighten-2;
    /* Mettiamo un bordo trasparente per riservare lo spazio ed evitare salti grafici */
    border: heavy transparent; 
    content-align: center middle;
    text-style: bold;
}

/* Effetto Mouse-Hover: 
   Sfondo azzurro/accent (Pedone) + Bordi verdi (Slot per il Muro) */
.casella:hover {
    background: $accent;
    color: $text;
    text-style: bold italic;
    
    /* Questa è la magia: illumina lo spazio TRA le caselle a destra e in basso */
    border-right: heavy $success;
    border-bottom: heavy $success;
}

/* -------------------------------------------------------- */
/* 6. GESTIONE GRAFICA DEI MURI EFFETTIVI                   */
/* -------------------------------------------------------- */

/* Muri reali piazzati dai giocatori (Spessi e di colore Arancio/Giallo) */
.muro-top { border-top: heavy $warning !important; }
.muro-bottom { border-bottom: heavy $warning !important; }
.muro-left { border-left: heavy $warning !important; }
.muro-right { border-right: heavy $warning !important; }

/* Muri di anteprima (opzionale): 
   Se da Python vuoi illuminare l'intera fessura lunga due caselle prima del click,
   puoi aggiungere queste classi via codice.
*/
.muro-preview-top { border-top: heavy $success-muted !important; }
.muro-preview-bottom { border-bottom: heavy $success-muted !important; }
.muro-preview-left { border-left: heavy $success-muted !important; }
.muro-preview-right { border-right: heavy $success-muted !important; }

/* -------------------------------------------------------- */
/* 7. PANNELLO DEI GIOCATORI (A Destra)                     */
/* -------------------------------------------------------- */

#pannello-giocatori, #pannello-laterale {
    width: 35;                   
    height: 100%;
    border-left: heavy $primary; 
    padding: 1 2;
    background: $panel;
}

#label-titolo-giocatori {
    text-align: center;
    text-style: bold;
    width: 100%;
    margin-bottom: 1;
    color: $accent;
}

.giocatore-box {
    width: 100%;
    height: auto;
    padding: 1;
    border: round $surface-lighten-2;
    margin-bottom: 1;
    background: $surface;
}

/* Colori ritoccati: Il giocatore di turno è molto visibile (Bordo doppio verde) */
.giocatore-attivo .giocatore-box, .giocatore-box.attivo {
    border: double $success;
    background: $success-muted;
}

.giocatore-eliminato .giocatore-box, .giocatore-box.eliminato {
    border: dashed $error;
    background: $surface-darken-1;
    color: $text-muted;
}

#label-input-hint {
    margin-top: 1;
    text-style: bold;
}

#input-mossa {
    width: 100%;
    margin-bottom: 1;
}

.label-errore {
    color: $error;
    text-style: bold;
    margin-top: 1;
    width: 100%;
    text-align: center;
}